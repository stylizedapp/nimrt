{
  "engine": "nimui-html-css",
  "version": "0.1.0",
  "unknownCssPolicyDefault": "warn-once",
  "unknownCssPolicies": ["warn-once", "ignore", "error"],
  "tags": {
    "supported": [
      "html",
      "head",
      "body",
      "style",
      "div",
      "section",
      "main",
      "header",
      "footer",
      "nav",
      "aside",
      "article",
      "form",
      "ul",
      "ol",
      "li",
      "p",
      "span",
      "h1",
      "h2",
      "h3",
      "h4",
      "h5",
      "h6",
      "label",
      "strong",
      "b",
      "em",
      "i",
      "code",
      "pre",
      "a",
      "button",
      "input",
      "textarea",
      "hr",
      "br"
    ],
    "parsedOnly": [
      "title",
      "meta",
      "link",
      "img",
      "table",
      "thead",
      "tbody",
      "tr",
      "th",
      "td",
      "small"
    ],
    "unsupported": [
      "canvas",
      "svg",
      "iframe",
      "video",
      "audio",
      "object",
      "embed",
      "script"
    ]
  },
  "attributes": {
    "supported": [
      "id",
      "class",
      "style",
      "type",
      "placeholder",
      "value",
      "disabled",
      "readonly",
      "data-bind-text",
      "data-bind-input",
      "data-on-click",
      "data-on-input",
      "data-caps"
    ],
    "parsedOnly": [
      "href",
      "src",
      "alt",
      "title",
      "name",
      "for",
      "role",
      "tabindex",
      "aria-label",
      "data-*"
    ],
    "unsupported": [
      "on*",
      "javascript: (href/src/action/formaction)"
    ]
  },
  "selectors": {
    "supported": [
      "*",
      "tag",
      ".class",
      "#id",
      "A B (descendant)",
      "A > B (direct-child)",
      ":hover",
      ":active",
      ":focus",
      ":focus-visible",
      ":focus-within",
      ":disabled",
      ":root"
    ],
    "parsedOnly": [
      "@media (min-width, max-width, prefers-color-scheme)"
    ],
    "unsupported": [
      ":has()",
      ":is()",
      ":where()",
      ":nth-child()",
      ":first-child",
      ":last-child",
      "::before",
      "::after",
      "[attr]",
      "A + B",
      "A ~ B"
    ]
  },
  "properties": {
    "supported": [
      "display (block|flex|inline|inline-block|none)",
      "flex-direction",
      "justify-content",
      "align-items",
      "align-self",
      "flex",
      "flex-grow",
      "flex-basis",
      "gap",
      "row-gap",
      "column-gap",
      "width",
      "height",
      "min-width",
      "max-width",
      "min-height",
      "max-height",
      "padding",
      "padding-top",
      "padding-right",
      "padding-bottom",
      "padding-left",
      "margin",
      "margin-top",
      "margin-right",
      "margin-bottom",
      "margin-left",
      "color",
      "background",
      "background-color",
      "background-image",
      "opacity",
      "border",
      "border-width",
      "border-color",
      "border-style",
      "border-top",
      "border-right",
      "border-bottom",
      "border-left",
      "border-radius",
      "box-shadow",
      "font-size",
      "text-align",
      "overflow",
      "overflow-y",
      "z-index",
      "--* (custom properties)",
      "var()"
    ],
    "parsedOnly": [
      "position",
      "top",
      "right",
      "bottom",
      "left",
      "flex-wrap",
      "flex-shrink",
      "font-weight",
      "font-family",
      "line-height",
      "cursor",
      "text-overflow",
      "white-space",
      "list-style",
      "list-style-type",
      "transition",
      "transition-property",
      "transition-duration",
      "transition-timing-function",
      "transition-delay",
      "box-sizing"
    ],
    "unsupported": [
      "display:grid",
      "display:inline-grid",
      "grid",
      "grid-template-columns",
      "grid-template-rows",
      "grid-template-areas",
      "grid-column",
      "grid-row",
      "grid-area",
      "grid-auto-flow",
      "float",
      "clear",
      "transform",
      "animation",
      "filter",
      "backdrop-filter",
      "clip-path"
    ]
  },
  "events": {
    "supported": [
      "data-on-click",
      "data-on-input",
      "click (QuickJS opt-in)",
      "input (QuickJS opt-in)"
    ],
    "unsupported": [
      "onclick (inline)",
      "oninput (inline)",
      "onload (inline)",
      "on* (inline HTML attributes)"
    ]
  },
  "limits": {
    "maxInstancesPerFrame": 16384,
    "maxCssVarDepth": 16,
    "maxMediaRecursionDepth": 8,
    "maxLayoutDepth": 256,
    "zeroJsDefault": true,
    "noExternalNetwork": true
  }
}
